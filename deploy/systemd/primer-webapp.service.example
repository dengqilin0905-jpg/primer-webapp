[Unit]
Description=Primer WebApp (Streamlit)
After=network.target

[Service]
Type=simple
User=APP_USER
Group=APP_USER
WorkingDirectory=/srv/primer-webapp/current
EnvironmentFile=/srv/primer-webapp/current/.env.server
ExecStart=/srv/primer-webapp/current/scripts/run_server.sh
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
