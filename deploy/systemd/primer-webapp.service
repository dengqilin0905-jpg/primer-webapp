[Unit]
Description=Primer WebApp (Streamlit)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/primer-webapp
EnvironmentFile=/opt/primer-webapp/.env.server
ExecStart=/opt/primer-webapp/scripts/run_server.sh
Restart=always
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
